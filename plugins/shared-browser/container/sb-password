#!/usr/bin/env bash
# Print the VNC password, creating one on first use.
#   sb-password          print it (create it if missing)
#   sb-password --init   create it only if missing; print nothing
#   sb-password --reset  make a new one and print it
# Xvnc reads /data/vncpasswd on each connection, so a reset takes effect on
# the next login without a restart.
set -euo pipefail
umask 077
PW=/data/password
VNC=/data/vncpasswd

valid() { [ -s "$PW" ] && [ -f "$VNC" ] && [ "$(stat -c %s "$VNC")" = 8 ]; }

make() {
  local pw="" tmp="$VNC.tmp"
  while [ "${#pw}" -lt 8 ]; do
    pw="$pw$(head -c 64 /dev/urandom | LC_ALL=C tr -dc 'A-HJ-NP-Za-km-z2-9')"
  done
  pw="${pw:0:8}"
  printf '%s\n' "$pw" | vncpasswd -f > "$tmp"
  [ "$(stat -c %s "$tmp")" = 8 ] || { echo "vncpasswd wrote a bad file" >&2; rm -f "$tmp"; exit 1; }
  mv "$tmp" "$VNC"
  printf '%s\n' "$pw" > "$PW"
}

case "${1:-}" in
  --init)  valid || make ;;
  --reset) make; cat "$PW" ;;
  "")      valid || make; cat "$PW" ;;
  *)       echo "usage: sb-password [--init|--reset]" >&2; exit 2 ;;
esac
